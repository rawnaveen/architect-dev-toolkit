{
  "description": "Safety guards (destructive commands, production changes, secret files, read-only agents) and automatic resume of PROGRESS.md for long-running tasks.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "timeout": 10,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard.py",
              "bash"
            ]
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "timeout": 10,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard.py",
              "files"
            ]
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "timeout": 10,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard.py",
              "progress"
            ]
          }
        ]
      }
    ]
  }
}
